generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  pending
  paid
  canceled
}

enum AccountType {
  SUPER_ADMIN
  ADMIN_OPERATION
  ADMIN_CS
  ADMIN_FINANCE
  MERCHANT_OWNER
  MERCHANT_STAFF
  USER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model Account {
  id              String                 @id @default(uuid()) @db.Uuid
  publicId        String                 @unique @map("public_id")
  accountType     AccountType            @map("account_type")
  email           String                 @unique
  phone           String                 @unique
  passwordHash    String                 @map("password_hash")
  status          AccountStatus          @default(INACTIVE)
  emailVerifiedAt DateTime?              @map("email_verified_at")
  phoneVerifiedAt DateTime?              @map("phone_verified_at")
  lastLoginAt     DateTime?              @map("last_login_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  userProfile     UserProfile?
  phoneOtps       PhoneVerificationOtp[]
  tickets         Ticket[]

  @@map("accounts")
}

model UserProfile {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @unique @map("account_id") @db.Uuid
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("users")
}

model PhoneVerificationOtp {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("phone_verification_otps")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String
  date        DateTime
  price       Decimal  @db.Decimal(10, 2)
  quota       Int
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tickets     Ticket[]

  @@map("events")
}

model Ticket {
  id          String       @id @default(uuid())
  eventId     String       @map("event_id")
  userId      String       @map("user_id") @db.Uuid
  status      TicketStatus @default(pending)
  purchasedAt DateTime     @default(now()) @map("purchased_at")

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user        Account      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([eventId])
  @@map("tickets")
}
